PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nfc_attendance?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/nfc_attendance?schema=public"
JWT_SECRET=your_jwt_secret_here

# Optional SMTP Email Configuration for Low Attendance Notifications
SMTP_HOST=smtp.example.com
